{
  "artifact": "Token registry transition: the IAM Host's status lists and the access tokens they hold",
  "authority": "2-security/9-security-token-status.md#the-list, 2-security/8-security-iam.md#access-tokens (iteration 02, WP-11.5); crates/permguard-host/src/authz/tokens.rs (TokenTransition)",
  "encoding": "deterministic CBOR (RFC 8949 core deterministic), integers in the signed 64-bit range",
  "maps": {
    "token_transition": {
      "keys": "int",
      "fields": [
        { "label": 1, "name": "kind", "type": "text", "occurs": "required", "note": "list.open, list.retire, token.issue or token.status" },
        { "label": 2, "name": "revision", "type": "uint", "occurs": "required", "note": "the registry revision the transition is" },
        { "label": 3, "name": "at", "type": "uint", "occurs": "required", "note": "seconds UTC" },
        { "label": 4, "name": "by", "type": "text", "occurs": "required", "note": "who made it" },
        { "label": 5, "name": "operation_id", "type": "bytes", "occurs": "optional", "note": "exactly 16 bytes: the security mutation that made it" },
        { "label": 6, "name": "list_id", "type": "bytes", "occurs": "optional", "note": "list.open, list.retire, token.issue: a UUIDv7" },
        { "label": 7, "name": "index", "type": "uint", "occurs": "optional", "note": "token.issue: the entry, below 2^20" },
        { "label": 8, "name": "jti", "type": "bytes", "occurs": "optional", "note": "token.issue, token.status: a UUIDv7" },
        { "label": 9, "name": "subject", "type": "text", "occurs": "optional", "note": "token.issue: sa:<name>, user:<name> or oidc:<issuer>#<subject>" },
        { "label": 10, "name": "client_id", "type": "text", "occurs": "optional", "note": "token.issue" },
        { "label": 11, "name": "family", "type": "text", "occurs": "optional", "note": "token.issue: application or administration" },
        { "label": 12, "name": "audience", "type": "array<text>", "occurs": "optional", "note": "token.issue: 1 to 16 entries" },
        { "label": 13, "name": "scope", "type": "text", "occurs": "optional", "note": "token.issue: the operations, space separated" },
        { "label": 14, "name": "expires_at", "type": "uint", "occurs": "optional", "note": "token.issue: seconds UTC" },
        { "label": 15, "name": "status", "type": "uint", "occurs": "optional", "note": "token.status: 0 valid, 1 invalid, 2 suspended" },
        { "label": 16, "name": "account", "type": "text", "occurs": "optional", "note": "token.issue: the service account it was issued to" },
        { "label": 17, "name": "credential_id", "type": "bytes", "occurs": "optional", "note": "token.issue: exactly 16 bytes, the credential it proved" },
        { "label": 18, "name": "role", "type": "text", "occurs": "optional", "note": "token.issue: the role the subject elevated to, as role:<name>; absent without elevation" }
      ]
