{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Permguard sign-in",
    "version": "1",
    "description": "The password sign-in and the first administrator's setup on the Server Host surface (WP-8.1, WP-8.2): `/auth/v1`, served by the IAM Host only (iteration 02, WP-11.1) and over TLS or a loopback address only. A session token is a bearer for the routes that take one; it never authorizes a Plane."
  },
  "paths": {
    "/auth/v1/sessions": {
      "post": {
        "operationId": "signIn",
        "summary": "Sign in with a password",
        "description": "A local user's name and password, and the second factor's `code` when the user holds one. Answers a session token, once.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A session opened: its token, answered once, the user, its expiry and how it was opened.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "description": "A body that is not a sign-in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "401": {
            "description": "The name, the password or the code is not right, or the user is locked out (`auth.refused`): one answer for all.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "403": {
            "description": "The surface is neither TLS nor a loopback address: no password crosses it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "503": {
            "description": "The sign-in could not be decided.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          }
        },
        "x-grpc-rpc": null,
        "x-grpc-note": "The Server Host surface's own route, REST only: a person's session never travels over gRPC.",
        "x-permguard-endpoint": {
          "plane": "iam",
          "category": "sign-in",
          "credential": "no (password)"
        }
      }
    },
    "/auth/v1/sessions/current": {
      "delete": {
        "operationId": "signOut",
        "summary": "Sign out",
        "description": "Ends the session the bearer names; a session that is not one is answered the same.",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "description": "`Bearer <session token>`: the token a sign-in answered.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The session is ended."
          }
        },
        "x-grpc-rpc": null,
        "x-grpc-note": "The Server Host surface's own route, REST only: a person's session never travels over gRPC.",
        "x-permguard-endpoint": {
          "plane": "iam",
          "category": "sign-in",
          "credential": "yes (session)",
          "operation": "own session",
          "target": "the caller's own user"
        }
      }
    },
    "/auth/v1/session": {
      "get": {
        "operationId": "getSession",
        "summary": "The current session",
        "description": "The session the bearer names, never its token.",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "description": "`Bearer <session token>`: the token a sign-in answered.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionView"
                }
              }
            }
          },
          "401": {
            "description": "No live session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          }
        },
        "x-grpc-rpc": null,
        "x-grpc-note": "The Server Host surface's own route, REST only: a person's session never travels over gRPC.",
        "x-permguard-endpoint": {
          "plane": "iam",
          "category": "sign-in",
          "credential": "yes (session)",
          "operation": "own session",
          "target": "the caller's own user"
        }
      }
    },
    "/auth/v1/password": {
      "post": {
        "operationId": "changePassword",
        "summary": "Change one's own password",
        "description": "The current password and the new one; the session stays open.",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "description": "`Bearer <session token>`: the token a sign-in answered.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordBody"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "The password is changed."
          },
          "400": {
            "description": "A new password the policy refuses (`auth.invalid`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "401": {
            "description": "No live session, or the current password is not right.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "503": {
            "description": "The change could not be recorded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          }
        },
        "x-grpc-rpc": null,
        "x-grpc-note": "The Server Host surface's own route, REST only: a person's session never travels over gRPC.",
        "x-permguard-endpoint": {
          "plane": "iam",
          "category": "sign-in",
          "credential": "yes (session)",
          "operation": "own session",
          "target": "the caller's own user"
        }
      }
    },
    "/auth/v1/factor": {
      "post": {
        "operationId": "beginFactor",
        "summary": "Enroll a second factor",
        "description": "The password again; answers the TOTP secret and its `otpauth://` URI, to be confirmed with a code.",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "description": "`Bearer <session token>`: the token a sign-in answered.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FactorBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The secret to enroll, answered once.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FactorEnrollment"
                }
              }
            }
          },
          "400": {
            "description": "A user that cannot enroll one (`auth.invalid`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "401": {
            "description": "No live session, or the password is not right.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "503": {
            "description": "The enrollment could not be recorded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          }
        },
        "x-grpc-rpc": null,
        "x-grpc-note": "The Server Host surface's own route, REST only: a person's session never travels over gRPC.",
        "x-permguard-endpoint": {
          "plane": "iam",
          "category": "sign-in",
          "credential": "yes (session)",
          "operation": "own session",
          "target": "the caller's own user"
        }
      }
    },
    "/auth/v1/factor/confirm": {
      "post": {
        "operationId": "confirmFactor",
        "summary": "Confirm a second factor",
        "description": "A code of the enrolled secret: from now on every sign-in asks for one.",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "description": "`Bearer <session token>`: the token a sign-in answered.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmBody"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "The second factor is confirmed."
          },
          "400": {
            "description": "A code that does not match (`auth.invalid`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "401": {
            "description": "No live session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "503": {
            "description": "The confirmation could not be recorded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          }
        },
        "x-grpc-rpc": null,
        "x-grpc-note": "The Server Host surface's own route, REST only: a person's session never travels over gRPC.",
        "x-permguard-endpoint": {
          "plane": "iam",
          "category": "sign-in",
          "credential": "yes (session)",
          "operation": "own session",
          "target": "the caller's own user"
        }
      }
    },
    "/auth/v1/setup": {
      "get": {
        "operationId": "getSetup",
        "summary": "Whether a setup code waits",
        "description": "While nobody administers the Host, or a recovery started offline waits: where the code came from and until when it serves. Never the code.",
        "responses": {
          "200": {
            "description": "A code waits.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupStatus"
                }
              }
            }
          },
          "404": {
            "description": "No code waits (`setup.closed`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "503": {
            "description": "The setup state cannot be read.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          }
        },
        "x-grpc-rpc": null,
        "x-grpc-note": "The Server Host surface's own route, REST only: a person's session never travels over gRPC.",
        "x-permguard-endpoint": {
          "plane": "iam",
          "category": "setup",
          "credential": "no (setup code)"
        }
      },
      "post": {
        "operationId": "completeSetup",
        "summary": "Make the first administrator",
        "description": "The setup code and the user to make: a local user holding `authz.admin` on the Host. The code is gone once used.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The first administrator is made.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupCompleted"
                }
              }
            }
          },
          "400": {
            "description": "A user the Host cannot make (`setup.invalid`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "401": {
            "description": "No code waits, or this one is not it, or it expired: one answer for all.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "404": {
            "description": "No code waits (`setup.closed`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "429": {
            "description": "Too many wrong codes recently (`setup.closed_for_now`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "503": {
            "description": "The setup could not be recorded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          }
        },
        "x-grpc-rpc": null,
        "x-grpc-note": "The Server Host surface's own route, REST only: a person's session never travels over gRPC.",
        "x-permguard-endpoint": {
          "plane": "iam",
          "category": "setup",
          "credential": "no (setup code)",
          "operation": "setup code",
          "target": "host"
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthError": {
        "type": "object",
        "description": "A refusal of the sign-in surface: a stable code and a message for a person.",
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "SignInBody": {
        "type": "object",
        "required": [
          "name",
          "password"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "The second factor's code, when the user holds one."
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "token",
          "user",
          "expires_at",
          "opened"
        ],
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string",
            "description": "The session token, answered once: only its digest is kept."
          },
          "user": {
            "type": "string"
          },
          "expires_at": {
            "type": "integer",
            "minimum": 0,
            "description": "Seconds since the epoch."
          },
          "opened": {
            "$ref": "#/components/schemas/Opened"
          }
        }
      },
      "SessionView": {
        "type": "object",
        "required": [
          "user",
          "expires_at",
          "opened"
        ],
        "additionalProperties": false,
        "properties": {
          "user": {
            "type": "string"
          },
          "expires_at": {
            "type": "integer",
            "minimum": 0,
            "description": "Seconds since the epoch."
          },
          "opened": {
            "$ref": "#/components/schemas/Opened"
          }
        }
      },
      "Opened": {
        "type": "string",
        "enum": [
          "password",
          "password+factor",
          "enroll-factor"
        ],
        "description": "How the session was opened; an `enroll-factor` session serves only the enrollment of a second factor."
      },
      "PasswordBody": {
        "type": "object",
        "required": [
          "current",
          "new"
        ],
        "additionalProperties": false,
        "properties": {
          "current": {
            "type": "string"
          },
          "new": {
            "type": "string"
          }
        }
      },
      "FactorBody": {
        "type": "object",
        "required": [
          "password"
        ],
        "additionalProperties": false,
        "properties": {
          "password": {
            "type": "string"
          }
        }
      },
      "FactorEnrollment": {
        "type": "object",
        "required": [
          "secret",
          "uri"
        ],
        "additionalProperties": false,
        "properties": {
          "secret": {
            "type": "string"
          },
          "uri": {
            "type": "string",
            "description": "The `otpauth://totp/` URI of the secret."
          }
        }
      },
      "ConfirmBody": {
        "type": "object",
        "required": [
          "code"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          }
        }
      },
      "SetupStatus": {
        "type": "object",
        "required": [
          "waiting",
          "origin",
          "expires_at"
        ],
        "additionalProperties": false,
        "properties": {
          "waiting": {
            "type": "boolean"
          },
          "origin": {
            "$ref": "#/components/schemas/SetupOrigin"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SetupOrigin": {
        "type": "string",
        "enum": [
          "generated",
          "secret",
          "recovery"
        ],
        "description": "Where the code came from: made by the Host, supplied by `host.setup.code_ref`, or made by a recovery started offline."
      },
      "SetupBody": {
        "type": "object",
        "required": [
          "code",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "SetupCompleted": {
        "type": "object",
        "required": [
          "user",
          "principal",
          "grant",
          "origin"
        ],
        "additionalProperties": false,
        "properties": {
          "user": {
            "type": "string"
          },
          "principal": {
            "type": "string"
          },
          "grant": {
            "type": [
              "string",
              "null"
            ],
            "description": "The grant of `authz.admin` on `host`; null when the user already held one."
          },
          "origin": {
            "$ref": "#/components/schemas/SetupOrigin"
          }
        }
      }
    }
  }
}
