  "info": {
    "title": "Permguard native PDP v1",
    "version": "1",
    "description": "The stateless decision interface `permguard.api.pdp.native.v1`."
  },
  "paths": {
    "/access/v1/evaluation": {
      "post": {
        "operationId": "pdpNativeEvaluation",
        "summary": "Decide one request.",
        "parameters": [
          {
            "name": "x-request-id",
            "in": "header",
            "required": false,
            "description": "A correlation identifier, bounded by the rule every surface applies; echoed in the response and kept in the decision record.",
            "schema": {
              "type": "string"
            },
            "x-grpc-field": null,
            "x-grpc-note": "a header: gRPC carries it as request metadata `x-request-id`, read by the same handler, not as a field of the input message"
          },
          {
            "name": "traceparent",
            "in": "header",
            "required": false,
            "description": "W3C trace context, parsed strictly and dropped when malformed.",
            "schema": {
              "type": "string"
            },
            "x-grpc-field": null,
            "x-grpc-note": "a header: gRPC carries it as request metadata `traceparent`, read by the same handler, not as a field of the input message"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The decision or the receipt.",
            "headers": {
              "x-request-id": {
                "description": "The caller's correlation identifier, echoed when admitted.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckResponse"
                }
              }
            }
          },
          "400": {
            "description": "The payload is malformed, names an unknown member or fails validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/WireError"
                }
              }
            }
          },
          "404": {
            "description": "The zone, ledger or profile is not served here.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/WireError"
                }
              }
            }
          },
          "500": {
            "description": "The plane failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/WireError"
                }
              }
            }
          },
          "503": {
            "description": "The ledger cannot be served, the evaluation is indeterminate, or a requested signature cannot be made (`response_signing_unavailable`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/WireError"
                }
              }
            }
          }
        },
        "x-grpc-rpc": "permguard.data.v1.PolicyDecisionPoint/Evaluate"
      }
    },
    "/access/v1/evaluations": {
      "post": {
        "operationId": "pdpNativeEvaluations",
