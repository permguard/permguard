          "500": {
            "description": "The plane failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/WireError"
                }
              }
            }
          },
          "503": {
            "description": "The ledger cannot be served, the evaluation is indeterminate, or a requested signature cannot be made (`response_signing_unavailable`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/WireError"
                }
              }
            }
          }
        },
        "x-grpc-rpc": "permguard.data.v1.PolicyDecisionPoint/EvaluateMany"
      }
    },
    "/.well-known/permguard-pdp-v1-configuration": {
      "get": {
        "operationId": "pdpNativeConfiguration",
        "summary": "What the native interface offers here.",
        "responses": {
          "200": {
