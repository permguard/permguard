{
  "uid": "permguard-data-plane",
  "title": "Permguard \u00b7 Data plane",
  "description": "The data plane: the decisions it answers, how fast, and out of what it holds in memory \u2014 beside the synchronization loop that keeps that memory current. Two questions on one page: is it answering, and is what it answers from current.",
  "tags": [
    "permguard",
    "data-plane"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Mirrors held",
      "description": "Ledgers this plane keeps a verified copy of.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "expr": "permguard_sync_mirrors",
          "legendFormat": "mirrors",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "Zones",
      "description": "Zones those mirrors belong to.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 3,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "expr": "permguard_sync_zones",
          "legendFormat": "zones",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "Oldest mirror",
      "description": "Seconds since the least recently synchronized mirror last completed a round \u2014 the freshness number to page on.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "expr": "max(permguard_sync_mirror_age_seconds)",
          "legendFormat": "age",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "Disk used",
      "description": "Bytes every mirror occupies on the volume.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 10,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "expr": "sum(permguard_sync_zone_bytes)",
          "legendFormat": "bytes",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "Rounds ok",
      "description": "Synchronization rounds that finished with nothing failing.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 14,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "expr": "sum(permguard_sync_rounds_total{outcome=\"ok\"})",
          "legendFormat": "ok",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "Rounds partial",
      "description": "Rounds where a mirror failed or a server did not answer.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 17,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "expr": "sum(permguard_sync_rounds_total{outcome=\"partial\"}) or vector(0)",
          "legendFormat": "partial",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "Rounds skipped",
      "description": "Ticks skipped because the previous round was still working \u2014 a cadence slower than configured.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "expr": "sum(permguard_sync_rounds_total{outcome=\"skipped\"}) or vector(0)",
          "legendFormat": "skipped",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "type": "timeseries",
      "title": "Mirror outcomes",
      "description": "Every mirror attempt, by how it ended. `empty` is a ledger with no history yet, not a problem.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "expr": "sum by (outcome) (rate(permguard_sync_mirrors_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Freshness per mirror",
      "description": "Seconds since each mirror last synchronized. A line that climbs is a mirror that stopped keeping up.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "expr": "permguard_sync_mirror_age_seconds",
          "legendFormat": "{{zone}}/{{ledger}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Round duration",
      "description": "How long a whole round takes, discovery included \u2014 against the interval it has to fit inside.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(permguard_sync_round_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(permguard_sync_round_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Mirror duration (p95)",
      "description": "The slow ledger, before its timeout starts firing.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (zone, ledger, le) (rate(permguard_sync_mirror_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{zone}}/{{ledger}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "bargauge",
      "title": "Ledgers per zone",
      "description": "Which zone carries the most ledgers on this plane.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "expr": "permguard_sync_zone_ledgers",
          "legendFormat": "{{zone}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "displayMode": "gradient",
        "orientation": "horizontal"
      }
    },
    {
      "type": "bargauge",
      "title": "Disk per zone",
      "description": "Which zone occupies the most of the volume \u2014 the question a full disk asks in retrospect.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 20
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "expr": "permguard_sync_zone_bytes",
          "legendFormat": "{{zone}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "displayMode": "gradient",
        "orientation": "horizontal"
      }
    },
    {
      "type": "table",
      "title": "Mirrors, in detail",
      "description": "Every mirror: the counter it stands at, its age, and what it occupies.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 20
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "expr": "permguard_sync_mirror_counter",
          "legendFormat": "counter",
          "refId": "A",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "expr": "permguard_sync_mirror_age_seconds",
          "legendFormat": "age",
          "refId": "B",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "expr": "permguard_sync_mirror_bytes",
          "legendFormat": "bytes",
          "refId": "C",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "type": "timeseries",
      "title": "Objects fetched",
      "description": "Objects pulled into mirrors \u2014 the shape of policy actually changing.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "expr": "sum by (zone, ledger) (rate(permguard_sync_fetched_objects_total[$__rate_interval]))",
          "legendFormat": "{{zone}}/{{ledger}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Mirrors removed",
      "description": "Mirrors reaped because the configuration no longer follows them.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "expr": "sum by (reason) (rate(permguard_sync_reaped_total[$__rate_interval]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "row",
      "title": "Decisions \u2014 the reason this plane exists",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Decisions / s",
      "description": "Authorization decisions answered, permits and denies together.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 37
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "expr": "sum(rate(permguard_authz_decisions_total[$__rate_interval]))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Permit rate",
      "description": "Share of decisions that permitted. A sudden move is either a policy change or an incident.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 37
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "expr": "sum(rate(permguard_authz_decisions_total{outcome=\"permit\"}[$__rate_interval])) / clamp_min(sum(rate(permguard_authz_decisions_total[$__rate_interval])), 0.001)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "p99 decision",
      "description": "What a caller feels, worst case in a hundred.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 37
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(permguard_authz_request_seconds_bucket[$__rate_interval])))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 4
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Cache hit rate",
      "description": "Compiled partitions found in memory. A falling number means the bounds are too small for what this plane serves.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 37
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "expr": "sum(rate(permguard_authz_cache_lookups_total{result=\"hit\"}[$__rate_interval])) / clamp_min(sum(rate(permguard_authz_cache_lookups_total[$__rate_interval])), 0.001)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Refusals / s",
      "description": "Requests that never reached a decision: malformed, not served here, or unavailable.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 37
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "expr": "sum(rate(permguard_authz_refusals_total[$__rate_interval]))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Blocked ledgers",
      "description": "Mirrors this engine may not serve. Anything above zero is somebody's upgrade waiting to happen.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 37
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "expr": "sum(permguard_authz_blocked_ledgers)",
