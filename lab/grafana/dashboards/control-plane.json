{
  "uid": "permguard-control-plane",
  "title": "Permguard \u00b7 Control plane",
  "description": "The control plane: the catalog it keeps, the transfers it serves, the decisions its data planes ship it, and what it holds on disk \u2014 per ledger, per zone and in total, so \"who is using the space\" is a panel rather than an ssh session.",
  "tags": [
    "permguard",
    "control-plane"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Zones",
      "description": "Zones the catalog holds.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "expr": "permguard_catalog_zones",
          "legendFormat": "zones",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "Ledgers",
      "description": "Ledgers it holds, across every zone.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 3,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "expr": "permguard_catalog_ledgers",
          "legendFormat": "ledgers",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "Pushes committed",
      "description": "Compare-and-swap commits that landed since start.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "expr": "sum(permguard_notp_operations_total{op=\"push_commit\",outcome=\"ok\"})",
          "legendFormat": "commits",
          "refId": "A"
