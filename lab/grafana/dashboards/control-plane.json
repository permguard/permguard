      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 14,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "expr": "sum(permguard_notp_operations_total{op=\"pull_negotiate\",outcome=\"ok\"})",
