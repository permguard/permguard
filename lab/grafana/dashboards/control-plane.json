      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "expr": "sum(permguard_notp_operations_total{outcome!=\"ok\"}) or vector(0)",
          "legendFormat": "refused",
          "refId": "A"
