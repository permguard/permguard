      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "type": "timeseries",
      "title": "NOTP operations",
      "description": "Rate of every verb, by outcome. Push is negotiate \u2192 upload \u2192 commit; pull is negotiate \u2192 fetch.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "expr": "sum by (op) (rate(permguard_notp_operations_total{outcome=\"ok\"}[$__rate_interval]))",
          "legendFormat": "{{op}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "expr": "sum(rate(permguard_notp_operations_total{outcome!=\"ok\"}[$__rate_interval]))",
          "legendFormat": "refused",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Operation latency (p95)",
      "description": "How long each verb takes at the 95th percentile \u2014 the number an average hides.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (op, le) (rate(permguard_notp_operation_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{op}} p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Wire bytes",
      "description": "Bytes carried by transfer batches, by direction and encoding \u2014 the deflate share is what compression saves.",
