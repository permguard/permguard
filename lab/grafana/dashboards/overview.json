    {
      "type": "timeseries",
      "title": "Requests per second, by surface",
      "description": "permguard_surface_requests_total, by surface. The telemetry surface appears too \u2014 Prometheus scraping itself is traffic.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (surface, component) (rate(permguard_surface_requests_total{component=~\"$component\"}[$__rate_interval]))",
          "legendFormat": "{{component}} \u00b7 {{surface}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
