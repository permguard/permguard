{
  "uid": "permguard-overview",
  "title": "Permguard \u00b7 Overview",
  "description": "Is it serving, how much, how fast, and what it is refusing. Every query here names a metric this build actually exposes.",
  "tags": [
    "permguard"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "component",
        "label": "Component",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "permguard-prometheus"
        },
        "definition": "label_values(permguard_up, component)",
        "query": {
          "query": "label_values(permguard_up, component)",
          "refId": "components"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Restarts",
        "datasource": {
          "type": "prometheus",
          "uid": "permguard-prometheus"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "changes(permguard_up[1m]) > 0",
        "titleFormat": "liveness changed"
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Live",
      "description": "permguard_up: the process is not wedged. A zero means restart it.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "editorMode": "code",
          "expr": "min(permguard_up{component=~\"$component\"})",
          "legendFormat": "live",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ],
            "mode": "absolute"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Ready",
      "description": "permguard_ready: the process is willing to be sent work. Goes to zero at the first instant of shutdown, before anything closes.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 3,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "editorMode": "code",
          "expr": "min(permguard_ready{component=~\"$component\"})",
          "legendFormat": "ready",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ],
            "mode": "absolute"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Requests per second",
      "description": "Every request every surface answered.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(permguard_surface_requests_total{component=~\"$component\"}[$__rate_interval]))",
          "legendFormat": "rps",
          "range": false,
          "instant": true,
          "refId": "A"
