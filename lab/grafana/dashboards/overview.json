    {
      "type": "stat",
      "title": "Targets up",
      "description": "How many Permguard telemetry endpoints Prometheus is reaching. Containers are discovered, so they appear only while they run; the two host addresses are fixed, and are down unless you started a plane yourself with `task run:all`.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 21,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(up{job=~\"permguard-.*\"} == 1)",
          "legendFormat": "targets",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
