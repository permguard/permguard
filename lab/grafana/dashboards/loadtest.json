{
  "uid": "permguard-loadtest",
  "title": "Permguard \u00b7 Load test",
  "description": "A k6 run and the server it hit, on one page. Pick runs with the Test run selector \u2014 every bench task tags itself as <script>-<timestamp>. Server-side series carry no testid (the server cannot know which generator hit it), so they show everything in the window.",
  "tags": [
    "permguard",
    "bench"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Request rate: sent vs answered",
      "description": "The two truths of one load test. The gap between them is requests refused before a handler \u2014 shed, per-peer, pool \u2014 or lost to the network.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(k6_http_reqs_total{testid=~\"$testid\"}[$__rate_interval]))",
          "legendFormat": "k6 \u00b7 sent \u00b7 {{testid}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(permguard_surface_requests_total{surface!=\"telemetry\"}[$__rate_interval]))",
          "legendFormat": "server \u00b7 answered",
          "range": true,
          "refId": "B"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Latency: what the client felt vs what the server measured",
      "description": "k6 measures from before connect to after the last byte; the server from the transport layer down. The difference is network plus the accept queue \u2014 on loopback it should be near zero, and against a remote it is the network's bill.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "editorMode": "code",
          "expr": "k6_http_req_duration_p95{testid=~\"$testid\"}",
          "legendFormat": "k6 \u00b7 p95 (client) \u00b7 {{testid}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "editorMode": "code",
          "expr": "k6_http_req_duration_p99{testid=~\"$testid\"}",
          "legendFormat": "k6 \u00b7 p99 (client) \u00b7 {{testid}}",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(permguard_surface_request_seconds_bucket{surface!=\"telemetry\"}[$__rate_interval])))",
          "legendFormat": "server \u00b7 p95",
          "range": true,
          "refId": "C"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Errors and refusals",
      "description": "A 503 during shed.js is the defence working; a transport failure is it failing. The k6 line is a ratio (0 to 1) of failed requests; the server lines are rates.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "editorMode": "code",
          "expr": "k6_http_req_failed_rate{testid=~\"$testid\"}",
          "legendFormat": "k6 \u00b7 failed (ratio) \u00b7 {{testid}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (status) (rate(permguard_surface_requests_total{status=~\"5..|4..\"}[$__rate_interval]))",
          "legendFormat": "server \u00b7 {{status}}",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (scope) (rate(permguard_surface_connections_refused_total[$__rate_interval]))",
          "legendFormat": "refused \u00b7 {{scope}}",
          "range": true,
          "refId": "C"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Connections and virtual users",
      "description": "Closed-loop runs hold roughly one connection per virtual user; the ladder holds whatever the arrival rate needs.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(permguard_surface_connections{surface!=\"telemetry\"})",
          "legendFormat": "server \u00b7 connections held",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "editorMode": "code",
          "expr": "k6_vus{testid=~\"$testid\"}",
          "legendFormat": "k6 \u00b7 virtual users \u00b7 {{testid}}",
          "range": true,
          "refId": "B"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Handshakes: what TLS costs on a cold connection",
      "description": "Meaningful in tls.js runs. On a warm, reused connection both sit at zero; what shows here is the price of the first request.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "editorMode": "code",
          "expr": "k6_http_req_tls_handshaking_p95{testid=~\"$testid\"}",
          "legendFormat": "TLS handshake \u00b7 p95 \u00b7 {{testid}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "editorMode": "code",
          "expr": "k6_http_req_connecting_p95{testid=~\"$testid\"}",
          "legendFormat": "TCP connect \u00b7 p95 \u00b7 {{testid}}",
          "range": true,
          "refId": "B"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Iteration rate by scenario",
      "description": "One iteration is one pass of the script's default function. For these benchmarks that is one request, so this should track the request rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "permguard-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "permguard-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (scenario) (rate(k6_iterations_total{testid=~\"$testid\"}[$__rate_interval]))",
          "legendFormat": "{{scenario}} \u00b7 {{testid}}",
          "range": true,
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "reqps"
        },
        "overrides": []
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "testid",
        "label": "Test run",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "permguard-prometheus"
        },
        "definition": "label_values(k6_http_reqs_total, testid)",
        "query": {
          "query": "label_values(k6_http_reqs_total, testid)",
          "refId": "testids"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 4
      }
    ]
  }
}
