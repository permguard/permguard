      "upstream": "parses"
    },
    {
      "prefix": "@id(\"a\")\n@id(\"b\")",
      "refused": true,
      "upstream": "parses"
    },
    {
      "prefix": "@id(\"bad\\q\")",
      "refused": true,
      "upstream": "parses"
    },
    {
