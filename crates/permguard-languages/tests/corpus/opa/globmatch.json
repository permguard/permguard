    "test-globmatch-0133.yaml": {
      "sha256": "sha256:820dfb9eca85078b31e51fbdb2f9d6b9b633473d8eb5b071b988d9929624007c",
      "cases": [
        {
          "note": "globmatch/glob match with . delimiter",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np contains x if {\n\tglob.match(\"*.github.com\", [\".\"], \"api.github.com\", x)\n}\n"
          ],
          "data": {
          },
          "want_result": [
            {
              "x": [
                true
              ]
            }
          ],
          "sort_bindings": true
        }
      ]
    },
