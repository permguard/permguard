    "test-globmatch-issue-5273.yaml": {
      "sha256": "sha256:3f7b0024f76314f92312a8e331a32878fd0b11a3431fe2f15bfef290c2a0d476",
      "cases": [
        {
          "note": "globmatch/no deadlocks for glob match",
          "query": "data.test.p = x",
          "modules": [
            "package test\n\np contains x if {\n\tglob.match(\"*.github.com\", [\".\"], \"api.github.com\", x)\n\tglob.match(\"*.github.com\", [\".\"], \"api.github.com\", x)\n}\n"
          ],
          "want_result": [
            {
              "x": [
                true
              ]
            }
          ]
        }
      ]
    },
    "test-globmatch-issue-5283.yaml": {
      "sha256": "sha256:e4f546ca88693af7f5993feffaabe0c13246cdf624f11f5f481b1e387a94f381",
      "cases": [
        {
          "note": "globmatch/captured negative results, variable",
          "query": "data.test.p = x",
          "modules": [
            "package test\n\np := x if {\n\tx := glob.match(\"*.github.com\", [\".\"], input)\n}\n"
          ],
          "input": "api.example.com",
          "want_result": [
            {
              "x": false
            }
          ]
        },
        {
          "note": "globmatch/captured negative result, constant",
          "query": "data.test.p = x",
          "modules": [
            "package test\n\np if {\n\tglob.match(\"*.github.com\", [\".\"], input, false)\n}\n"
          ],
          "input": "api.example.com",
          "want_result": [
            {
              "x": true
            }
          ]
        }
      ]
    }
  }
