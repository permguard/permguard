      "cases": [
        {
          "note": "defaultkeyword/defined-ooo",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np := 1\n\ndefault p := 0\n\np := 2 if {\n\tfalse\n}\n"
          ],
          "data": {
