{
  "folder": "defaultkeyword",
  "files": {
    "test-default-functions.yaml": {
      "sha256": "sha256:73646f2b43c7abc5e77b535b9464df92408b99270f2dedc822850053d261c36c",
      "cases": [
        {
          "note": "defaultkeyword/function with var arg",
          "query": "data.test = x",
          "modules": [
            "package test\n\ndefault f(_) := 100\n"
          ],
          "want_result": [
            {
              "x": {
              }
            }
          ]
        },
        {
          "note": "defaultkeyword/function with var arg, ref head",
          "query": "data.test = x",
          "modules": [
            "package test\n\ndefault p.q.r.f(x) := 100\n"
          ],
          "want_result": [
            {
              "x": {
                "p": {
                  "q": {
                    "r": {
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "note": "defaultkeyword/function with var arg, ref head query",
          "query": "data.test.foo = x",
          "modules": [
            "package test\n\ndefault p.q.r.f(x) := 100\n\np.q.r.f(x) := x if {\n\tx == 2\n}\n\nfoo if {\n\tp.q.r.f(3) == 100\n}\n"
          ],
          "want_result": [
            {
              "x": true
            }
          ]
        }
      ]
    },
    "test-defaultkeyword-0804.yaml": {
      "sha256": "sha256:1bb77350e6d82f0d3a019ce7703398667ee8e63f38b52a5ae0a2b0255f7eb5a3",
      "cases": [
        {
          "note": "defaultkeyword/undefined",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np := 1 if {\n\tfalse\n}\n\ndefault p := 0\n\np := 2 if {\n\tfalse\n}\n"
          ],
          "data": {
          },
          "want_result": [
            {
              "x": 0
            }
          ]
        }
      ]
    },
