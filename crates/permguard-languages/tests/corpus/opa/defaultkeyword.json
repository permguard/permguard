    "test-defaultkeyword-0807.yaml": {
      "sha256": "sha256:0324a2c9a3f4a7872de69793791e3d14f7cbe058dc9d3f1802bc1082eff9ce5a",
      "cases": [
        {
          "note": "defaultkeyword/array comprehension",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np := 1 if {\n\tfalse\n}\n\ndefault p := [x | data.a[_] = x]\n"
          ],
          "data": {
            "a": [
              "1",
              "2",
              "3",
              "4"
            ]
          },
          "want_result": [
            {
              "x": [
                "1",
                "2",
                "3",
                "4"
              ]
            }
          ]
        }
      ]
    },
    "test-defaultkeyword-0808.yaml": {
      "sha256": "sha256:f887acb21aead6cb0aa5e1601ce264fec745a5a8579e289cce71a84c5cf6c832",
      "cases": [
        {
          "note": "defaultkeyword/object comprehension",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np := 1 if {\n\tfalse\n}\n\ndefault p := {x: k | data.d[k][_] = x}\n"
          ],
          "data": {
            "d": {
              "e": [
                "bar",
                "baz"
              ]
            }
          },
          "want_result": [
            {
              "x": {
                "bar": "e",
                "baz": "e"
              }
            }
          ]
        }
      ]
    },
    "test-defaultkeyword-0809.yaml": {
      "sha256": "sha256:8c3ab5d274cc8e079382c7f8372e6ac131121b69be70bdeabc0ca256aacd942e",
      "cases": [
        {
          "note": "defaultkeyword/set comprehension",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np := 1 if {\n\tfalse\n}\n\ndefault p := {x | data.a[_] = x}\n"
          ],
          "data": {
            "a": [
              "1",
              "2",
              "3",
              "4"
            ]
          },
          "want_result": [
            {
