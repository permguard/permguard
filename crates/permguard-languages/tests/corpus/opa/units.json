    "test-parse-bytes-errors.yaml": {
      "sha256": "sha256:323fef2e6f83f2012ea68d3ff962736a6de76a14f56aefeb08c04492af780716",
      "cases": [
        {
          "note": "units_parse_bytes/failure",
          "query": "data.test.p = x",
          "modules": [
            "package test\n\np if {\n\tunits.parse_bytes(\"\")\n}\n"
          ],
          "want_error_code": "eval_builtin_error",
          "want_error": "units.parse_bytes: no byte amount provided",
          "strict_error": true
        },
        {
          "note": "units_parse_bytes/failure",
          "query": "data.test.p = x",
          "modules": [
            "package test\n\np if {\n\tunits.parse_bytes(\"GB\")\n}\n"
          ],
          "want_error_code": "eval_builtin_error",
          "want_error": "units.parse_bytes: no byte amount provided",
          "strict_error": true
        },
        {
          "note": "units_parse_bytes/failure",
          "query": "data.test.p = x",
          "modules": [
            "package test\n\np if {\n\tunits.parse_bytes(\"foo\")\n}\n"
          ],
          "want_error_code": "eval_builtin_error",
          "want_error": "units.parse_bytes: no byte amount provided",
          "strict_error": true
        },
        {
          "note": "units_parse_bytes/failure",
          "query": "data.test.p = x",
          "modules": [
            "package test\n\np if {\n\tunits.parse_bytes(\"0.0.0\")\n}\n"
          ],
          "want_error_code": "eval_builtin_error",
          "want_error": "units.parse_bytes: could not parse byte amount to a number",
          "strict_error": true
        },
        {
          "note": "units_parse_bytes/failure",
          "query": "data.test.p = x",
          "modules": [
            "package test\n\np if {\n\tunits.parse_bytes(\".5.2\")\n}\n"
          ],
          "want_error_code": "eval_builtin_error",
          "want_error": "units.parse_bytes: could not parse byte amount to a number",
          "strict_error": true
        },
        {
          "note": "units_parse_bytes/failure",
          "query": "data.test.p = x",
          "modules": [
            "package test\n\np if {\n\tunits.parse_bytes(\"100 kb\")\n}\n"
          ],
          "want_error_code": "eval_builtin_error",
          "want_error": "units.parse_bytes: spaces not allowed in resource strings",
          "strict_error": true
        },
        {
          "note": "units_parse_bytes/failure",
          "query": "data.test.p = x",
          "modules": [
