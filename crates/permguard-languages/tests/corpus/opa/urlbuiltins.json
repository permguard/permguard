    "test-urlbuiltins-1076.yaml": {
      "sha256": "sha256:e09b1fe6e26d75739ce4a78a568984ebb9b73639deae2baea93e2ffdb057ffa9",
      "cases": [
        {
          "note": "urlbuiltins/decode_object multiple",
          "query": "data.decode_object.p = x",
          "modules": [
            "package decode_object\n\np := x if {\n\tx = urlquery.decode_object(\"a=value_a1&b=value_b&a=value_a2\")\n}\n"
          ],
          "want_result": [
            {
              "x": {
                "a": [
                  "value_a1",
                  "value_a2"
                ],
                "b": [
                  "value_b"
                ]
              }
            }
          ]
        },
        {
          "note": "urlbuiltins/decode_object empty parameter",
          "query": "data.decode_object.p = x",
          "modules": [
            "package decode_object\n\np := x if {\n\tx = urlquery.decode_object(\"a=value_a1&b\")\n}\n"
          ],
          "want_result": [
            {
              "x": {
                "a": [
                  "value_a1"
                ],
                "b": [
                  ""
                ]
              }
            }
          ]
        },
        {
          "note": "urlbuiltins/decode_object empty string",
          "query": "data.decode_object.p = x",
          "modules": [
            "package decode_object\n\np := x if {\n\tx = urlquery.decode_object(\"\")\n}\n"
          ],
          "want_result": [
            {
              "x": {
              }
            }
          ]
        }
      ]
    }
  }
}
