        {
          "note": "urlbuiltins/encode_object set",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np := x if {\n\turlquery.encode_object({\"a\": {\"b+1\"}}, x)\n}\n"
          ],
          "data": {
