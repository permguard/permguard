{
  "folder": "urlbuiltins",
  "files": {
    "test-urlbuiltins-0939.yaml": {
      "sha256": "sha256:f0b32aeb9d0711eb5a31a7d9f932c415d0704507dcedc556afbd67c8d54d7d0b",
      "cases": [
        {
          "note": "urlbuiltins/encode",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np := x if {\n\turlquery.encode(\"a=b+1\", x)\n}\n"
          ],
          "data": {
          },
          "want_result": [
            {
              "x": "a%3Db%2B1"
            }
          ]
        }
      ]
    },
    "test-urlbuiltins-0940.yaml": {
      "sha256": "sha256:6c46b03f0d44b3e6e8e1b14e1d90687180e31ac8a94e8bd30233eb378a99d861",
      "cases": [
        {
          "note": "urlbuiltins/encode empty",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np := x if {\n\turlquery.encode(\"\", x)\n}\n"
          ],
          "data": {
          },
          "want_result": [
            {
              "x": ""
            }
          ]
        }
      ]
    },
    "test-urlbuiltins-0941.yaml": {
