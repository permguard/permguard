    "test-bitsand-0057.yaml": {
      "sha256": "sha256:a42d1ff759858aa90d2a667aaf701da2a4399263d60bf5c0d69bcb08718715aa",
      "cases": [
        {
          "note": "bitsand/lhs (float) error",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np := __local0__ if {\n\tbits.and(7.2, 42, __local1__)\n\t__local0__ = __local1__\n}\n"
          ],
          "data": {
          },
          "want_error_code": "eval_type_error",
          "want_error": "bits.and: operand 1 must be integer number but got floating-point number",
          "strict_error": true
        }
      ]
