      "cases": [
        {
          "note": "bitsand/and with zero is and",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np contains __local0__ if {\n\tbits.and(50, 0, __local1__)\n\t__local0__ = __local1__\n}\n"
          ],
          "data": {
          },
          "want_result": [
            {
              "x": [
                0
              ]
            }
