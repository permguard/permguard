    "test-comprehensions-0781.yaml": {
      "sha256": "sha256:aa6c4569d77bd023f76fb4e70a3148983acbcc83a2efab273c6d909d874b8176",
      "cases": [
        {
          "note": "comprehensions/array simple",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np contains i if {\n\txs = [x | x = data.a[_]]\n\t__local0__ = xs[i]\n\t__local0__ > 1\n}\n"
          ],
          "data": {
            "a": [
              1,
              2,
              3,
              4
            ]
          },
          "want_result": [
            {
              "x": [
                1,
                2,
                3
              ]
            }
          ],
          "sort_bindings": true
        }
      ]
    },
