    "test-comprehensions-0790.yaml": {
      "sha256": "sha256:6f09bcb230afc0479d40a1c57b65bed4bec4d1d87027c51b6e1d75be83da401c",
      "cases": [
        {
          "note": "comprehensions/object nested",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np := r if {\n\tr = {x: y | z = {i: q | i = data.b[q]}; x = z[y]}\n}\n"
          ],
          "data": {
            "b": {
              "v1": "hello",
              "v2": "goodbye"
            }
          },
          "want_result": [
            {
              "x": {
                "v1": "hello",
                "v2": "goodbye"
              }
            }
          ]
        }
      ]
    },
