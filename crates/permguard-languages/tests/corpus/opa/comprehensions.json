    "test-comprehensions-and-vars.yaml": {
      "sha256": "sha256:92ea0847620ac75af09311ad82ce53a8600ff104b76653542137133fe29730a1",
      "cases": [
        {
          "note": "comprehensions/var bindings have no effect outside",
          "query": "data.test.p = x",
          "modules": [
            "package test\n\nxs := {\"a\", \"b\", \"c\"}\n\np := x if {\n\ty := {x | xs[x]}\n\tz := {x | xs[x]}\n\tcount(y) == count(z)\n\tx := count(y)\n}\n"
          ],
          "want_result": [
            {
              "x": 3
            }
          ]
        }
      ]
