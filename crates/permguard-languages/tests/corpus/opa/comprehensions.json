    "test-comprehensions-0795.yaml": {
      "sha256": "sha256:2123e3459976f6a1ec5746f47600021d58b91463b304168d92371e7d68f47653",
      "cases": [
        {
          "note": "comprehensions/object dereference embedded",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\narr := [4]\n\np contains x if {\n\tdata.generated.q.a = x\n}\n\nq[k] := v if {\n\tk = \"a\"\n\tv = {\"bar\": y | i = {\"foo\": z | z = data.generated.arr[_]}; i[_] = _; i = y}\n}\n"
          ],
          "data": {
          },
          "want_result": [
            {
              "x": [
                {
                  "bar": {
                    "foo": 4
                  }
                }
              ]
            }
          ],
          "sort_bindings": true
        }
      ]
    },
    "test-comprehensions-0796.yaml": {
      "sha256": "sha256:420766181205b6ea26fecf862e94023c456fd11fdbee9788132caef9d0232c2e",
      "cases": [
        {
          "note": "comprehensions/object conflict",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np contains x if {\n\tdata.generated.q.a = x\n}\n\nq[k] := v if {\n\tk = \"a\"\n\tv = {\"bar\": y | i = {\"foo\": z | z = data.a[_]}; i[_] = _; i = y}\n}\n"
          ],
          "data": {
            "a": [
              1,
              2,
              3,
              4
            ]
          },
          "want_error_code": "eval_conflict_error",
          "want_error": "object keys must be unique"
        }
      ]
    },
