    "test-objectfilter-0300.yaml": {
      "sha256": "sha256:e9b66bb49c239df8852db4538a49c147a9881202e64e7cdf036cb54a10693a7d",
      "cases": [
        {
          "note": "objectfilter/base",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np := __local0__ if {\n\tobject.filter({\"a\": {\"b\": {\"c\": 7, \"d\": 8}}, \"e\": 9}, {\"a\"}, __local1__)\n\t__local0__ = __local1__\n}\n"
          ],
          "data": {
          },
          "want_result": [
            {
              "x": {
                "a": {
                  "b": {
                    "c": 7,
                    "d": 8
                  }
                }
              }
            }
          ]
        }
      ]
    },
