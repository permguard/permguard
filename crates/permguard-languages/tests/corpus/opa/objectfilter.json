    "test-objectfilter-0309.yaml": {
      "sha256": "sha256:eeb3d50a2c9b1bceed1e50ccb50da1523637cdf4d66027278322fe34f8d9f8b6",
      "cases": [
        {
          "note": "objectfilter/error invalid object param type array input",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np := __local0__ if {\n\t__local2__ = input.x\n\tobject.filter(__local2__, {\"a\"}, __local1__)\n\t__local0__ = __local1__\n}\n"
          ],
          "input_term": "{\"x\": [\"a\"]}",
          "want_error_code": "eval_type_error",
          "want_error": "object.filter: operand 1 must be object but got array",
          "strict_error": true
        }
      ]
    },
