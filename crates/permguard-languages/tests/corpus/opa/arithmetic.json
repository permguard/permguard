    "test-arithmetic-minus-type-error.yaml": {
      "sha256": "sha256:566fb6e75d43ecb41812f84d632168c3d67762c6f41f494c34a604c1539fbe61",
      "cases": [
        {
          "note": "arithmetic/minus/type error",
          "query": "data.test.p = x",
          "modules": [
            "package test\n\np if {\n\t{1} - 1\n}\n"
          ],
          "want_error_code": "eval_type_error",
          "want_error": "operand 2 must be set but got number",
          "strict_error": true
        },
        {
          "note": "arithmetic/minus/type error",
          "query": "data.test.p = x",
          "modules": [
            "package test\n\np if {\n\t1 - {1}\n}\n"
          ],
          "want_error_code": "eval_type_error",
          "want_error": "operand 2 must be number but got set",
          "strict_error": true
        }
      ]
    },
