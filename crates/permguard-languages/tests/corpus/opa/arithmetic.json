    "test-arithmetic-0810.yaml": {
      "sha256": "sha256:cee6893b93dffd16b83034e62b0a9dd9385459ca5c4db2fed0a25a6c2345bcbd",
      "cases": [
        {
          "note": "arithmetic/plus",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np contains y if {\n\tdata.a[i] = x\n\t__local0__ = i + x\n\ty = __local0__\n}\n"
          ],
          "data": {
            "a": [
              1,
              2,
              3,
              4
            ]
          },
          "want_result": [
            {
              "x": [
                1,
                3,
                5,
                7
              ]
            }
          ],
          "sort_bindings": true
        }
      ]
    },
