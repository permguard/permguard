      "cases": [
        {
          "note": "arithmetic/divide+error",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np := y if {\n\tdata.a[i] = x\n\t__local0__ = x / i\n\ty = __local0__\n}\n"
          ],
          "data": {
