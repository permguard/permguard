    "test-objectunion-0277.yaml": {
      "sha256": "sha256:38c2a05dc89544d9e857c617503a0d4323b5452f981503e273519b3e0279d69f",
      "cases": [
        {
          "note": "objectunion/error wrong lhs type input",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np := __local0__ if {\n\t__local2__ = input.a\n\tobject.union(__local2__, {\"b\": 2}, __local1__)\n\t__local0__ = __local1__\n}\n"
          ],
          "data": {
          },
          "input_term": "{\"a\": [1, 2, 3]}",
          "want_error_code": "eval_type_error",
          "want_error": "object.union: operand 1 must be object but got array",
          "strict_error": true
        }
      ]
    },
