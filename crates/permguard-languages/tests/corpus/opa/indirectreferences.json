      "cases": [
        {
          "note": "indirectreferences/array",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np contains x if {\n\t__local0__ = [1, 2, 3]\n\t__local0__[x]\n}\n"
          ],
          "data": {
          },
          "want_result": [
            {
              "x": [
