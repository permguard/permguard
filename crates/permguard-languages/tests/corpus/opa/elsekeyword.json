    "test-elsekeyword-1058.yaml": {
      "sha256": "sha256:0cda815f49cc9fa6ca55e119fd240c949188f93fdbfa9800c072d7931a5b6866",
      "cases": [
        {
          "note": "elsekeyword/var-head",
          "query": "data.ex.vars = x",
          "modules": [
            "package ex\n\nvars if {\n\tfalse\n} else := [\"hello\", x] if {\n\tdata.b.v2 = x\n}\n"
          ],
          "data": {
            "a": [
              "1",
              "2",
              "3",
              "4"
            ],
            "b": {
              "v1": "hello",
              "v2": "goodbye"
            }
          },
          "want_result": [
            {
              "x": [
                "hello",
                "goodbye"
              ]
            }
          ]
        }
      ]
    },
