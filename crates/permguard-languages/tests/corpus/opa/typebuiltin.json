    "test-typebuiltin-0828.yaml": {
      "sha256": "sha256:1f11f373035b4d7c2063badad0b4ff868149ee9f72f846130d3dee9b4af5ba16",
      "cases": [
        {
          "note": "typebuiltin/is_number",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np := [x, y, z] if {\n\tis_number(-42.0, x)\n\tis_number(0, y)\n\tis_number(100.1, z)\n}\n"
          ],
          "data": {
          },
          "want_result": [
            {
              "x": [
                true,
                true,
                true
              ]
            }
          ]
        }
      ]
    },
    "test-typebuiltin-0829.yaml": {
