      "cases": [
        {
          "note": "undos/array-type",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np contains x if {\n\tarr = [[1, [2]], [1, null], [2, [2]]]\n\t[x, [2]] = arr[_]\n}\n"
          ],
          "data": {
          },
          "want_result": [
            {
              "x": [
                1,
                2
              ]
            }
          ],
          "sort_bindings": true
        }
      ]
    },
