      "cases": [
        {
          "note": "base64builtins/encode-1",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np := x if {\n\tbase64.encode(\"hello\", x)\n}\n"
          ],
          "data": {
          },
          "want_result": [
            {
              "x": "aGVsbG8="
            }
          ]
        }
      ]
    },
