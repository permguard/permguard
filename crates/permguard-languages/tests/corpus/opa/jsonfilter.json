    "test-jsonfilter-0218.yaml": {
      "sha256": "sha256:369df75da6033726177c07f60400e1a1d9ca185a0c948b33d1f033afd7f4eb78",
      "cases": [
        {
          "note": "jsonfilter/base",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np := __local0__ if {\n\tjson.filter({\"a\": {\"b\": {\"c\": 7, \"d\": 8}}, \"e\": 9}, {\"a/b/c\"}, __local1__)\n\t__local0__ = __local1__\n}\n"
          ],
          "data": {
          },
          "want_result": [
            {
              "x": {
                "a": {
                  "b": {
                    "c": 7
                  }
                }
              }
            }
          ]
        }
      ]
    },
