    "test-membership.yaml": {
      "sha256": "sha256:aaf22eac907d892d592e3f03dd5f4089b804904c58e5106a34dbf57b7cc63fd4",
      "cases": [
        {
          "note": "aggregates/member simple, set",
          "query": "data.test.p = x",
          "modules": [
            "package test\n\np if {\n\t1 in {1}\n}\n"
          ],
          "data": {
          },
          "want_result": [
            {
              "x": true
            }
          ]
        },
        {
          "note": "aggregates/member simple, array",
          "query": "data.test.p = x",
          "modules": [
            "package test\n\np if {\n\t1 in [1]\n}\n"
          ],
          "data": {
          },
          "want_result": [
            {
              "x": true
            }
          ]
        },
        {
          "note": "aggregates/member simple, object",
          "query": "data.test.p = x",
          "modules": [
            "package test\n\np if {\n\t1 in {\"foo\": 1}\n}\n"
          ],
          "data": {
          },
          "want_result": [
            {
              "x": true
            }
          ]
        },
        {
          "note": "aggregates/member object with key",
          "query": "data.test.p = x",
          "modules": [
            "package test\n\np if {\n\t\"foo\", 1 in {\"foo\": 1}\n}\n"
          ],
          "data": {
          },
          "want_result": [
            {
              "x": true
            }
          ]
        },
        {
          "note": "aggregates/member array with index",
          "query": "data.test.p = x",
          "modules": [
            "package test\n\np if {\n\t1, \"two\" in [\"one\", \"two\", \"three\"]\n}\n"
          ],
          "data": {
          },
          "want_result": [
            {
              "x": true
            }
          ]
        },
        {
          "note": "aggregates/member array with index, nested",
          "query": "data.test.p = x",
          "modules": [
            "package test\n\np if {\n\t1, 2 in [2] in [false, true]\n}\n"
          ],
          "data": {
          },
          "want_result": [
            {
              "x": true
            }
          ]
        },
        {
          "note": "aggregates/member array with index, nested, associativity without parens",
          "query": "data.test.p = x",
          "modules": [
            "package test\n\np if {\n\t(0, 2 in [2]) in [true]\n}\n"
          ],
          "data": {
          },
          "want_result": [
            {
              "x": true
            }
          ]
        },
        {
          "note": "aggregates/member object with key, nested, associativity without parens",
          "query": "data.test.p = x",
          "modules": [
            "package test\n\np if {\n\t(\"foo\", 2 in {\"foo\": 2}) in [true]\n}\n"
          ],
          "data": {
          },
          "want_result": [
            {
              "x": true
            }
          ]
