    "test-aggregates-0028.yaml": {
      "sha256": "sha256:7c79c2a3b73f00db832bfb946e497a1545eac93b444a769164af7ec185c890b5",
      "cases": [
        {
          "note": "aggregates/count error null",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np := x if {\n\tcount(input.foo, x)\n}\n"
          ],
          "input": {
            "foo": null
          },
          "want_error_code": "eval_type_error",
          "want_error": "operand 1 must be one of {array, object, set, string} but got null",
          "strict_error": true
        },
        {
          "note": "aggregates/count error number",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np := x if {\n\tcount(input.foo, x)\n}\n"
          ],
          "input": {
            "foo": 5
          },
          "want_error_code": "eval_type_error",
          "want_error": "operand 1 must be one of {array, object, set, string} but got number",
          "strict_error": true
        }
      ]
    },
