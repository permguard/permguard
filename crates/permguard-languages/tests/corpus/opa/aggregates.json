    "test-aggregates-0001.yaml": {
      "sha256": "sha256:5fa25200993fe50435f3ae7c9ed685b7198f01637016052268a9e1ca4d489f06",
      "cases": [
        {
          "note": "aggregates/count",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np contains x if {\n\t__local0__ = data.a\n\tcount(__local0__, x)\n}\n"
          ],
          "data": {
            "a": [
              1,
              2,
              3,
              4
            ]
          },
          "want_result": [
            {
              "x": [
                4
              ]
            }
          ],
          "sort_bindings": true
        }
      ]
    },
