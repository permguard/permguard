    "test-time-0947.yaml": {
      "sha256": "sha256:85259b86b207fa0ebb61f1447a459bff7c91e4947360fb76594f2fc041b8ec4f",
      "cases": [
        {
          "note": "time/time caching",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np if {\n\ttime.now_ns(t0)\n\ttest.sleep(\"10ms\")\n\ttime.now_ns(t1)\n\tt0 == t1\n}\n"
          ],
          "data": {
          },
          "want_result": [
            {
              "x": true
            }
          ]
        }
      ]
    },
    "test-time-0948.yaml": {
      "sha256": "sha256:72b31b29231b85260bec1b00b8743a45bf3b3d880dbc1398795d66797859e855",
      "cases": [
        {
          "note": "time/parse_nanos",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np[case_id] := ns if {\n\tcase := input.cases[case_id]\n\ttime.parse_ns(case.layout, case.value, ns)\n}\n"
          ],
          "input": {
            "cases": {
              "1": {
                "layout": "2006-01-02T15:04:05Z07:00",
                "value": "2017-06-02T19:00:00-07:00"
              },
              "2": {
                "layout": "2006-01-02T15:04:05Z07:00",
                "value": "1677-09-21T00:12:43.145224192-00:00"
              },
              "3": {
                "layout": "2006-01-02T15:04:05Z07:00",
                "value": "2262-04-11T23:47:16.854775807-00:00"
              },
              "4": {
                "layout": "01/02 03:04:05PM '06 -0700",
                "value": "06/02 07:00:00PM '17 -0700"
              },
              "5": {
                "layout": "02 Jan 06 15:04 -0700",
                "value": "02 Jun 17 19:00 -0700"
              },
              "6": {
                "layout": "RFC822Z",
                "value": "02 Jun 17 19:00 -0700"
              }
            }
          },
          "want_result": [
            {
              "x": {
                "1": 1496455200000000000,
                "2": -9223372036854775808,
                "3": 9223372036854775807,
                "4": 1496455200000000000,
                "5": 1496455200000000000,
                "6": 1496455200000000000
              }
            }
          ]
        },
        {
          "note": "time/parse_nanos_too_small",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np := ns if {\n\ttime.parse_ns(\"2006-01-02T15:04:05Z07:00\", \"1677-09-21T00:12:43.145224191-00:00\", ns)\n}\n"
          ],
          "want_error_code": "eval_builtin_error",
          "want_error": "time outside of valid range",
          "strict_error": true
        },
        {
          "note": "time/parse_nanos_too_large",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np := ns if {\n\ttime.parse_ns(\"2006-01-02T15:04:05Z07:00\", \"2262-04-11T23:47:16.854775808-00:00\", ns)\n}\n"
          ],
          "want_error_code": "eval_builtin_error",
          "want_error": "time outside of valid range",
          "strict_error": true
        }
      ]
    },
    "test-time-0949.yaml": {
      "sha256": "sha256:03853382e4eccb2a38f2cdcd4972085d359620f71de5664f190343be026a80e0",
      "cases": [
        {
          "note": "time/parse_rfc3339_nanos",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np[t] := ns if {\n\tt = input.cases[_]\n\ttime.parse_rfc3339_ns(t, ns)\n}\n"
          ],
          "input": {
            "cases": [
              "1677-09-21T00:12:43.145224192-00:00",
              "1970-01-01T00:00:00-00:00",
              "2017-06-02T19:00:00-07:00",
              "2262-04-11T23:47:16.854775807-00:00"
            ]
          },
          "want_result": [
            {
              "x": {
                "1677-09-21T00:12:43.145224192-00:00": -9223372036854775808,
                "1970-01-01T00:00:00-00:00": 0,
                "2017-06-02T19:00:00-07:00": 1496455200000000000,
                "2262-04-11T23:47:16.854775807-00:00": 9223372036854775807
              }
            }
          ]
        },
        {
          "note": "time/parse_rfc3339_nanos_too_small",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np := ns if {\n\ttime.parse_rfc3339_ns(\"1677-09-21T00:12:43.145224191-00:00\", ns)\n}\n"
          ],
          "want_error_code": "eval_builtin_error",
          "want_error": "time outside of valid range",
          "strict_error": true
        },
        {
          "note": "time/parse_rfc3339_nanos_too_large",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np := ns if {\n\ttime.parse_rfc3339_ns(\"2262-04-11T23:47:16.854775808-00:00\", ns)\n}\n"
          ],
          "want_error_code": "eval_builtin_error",
          "want_error": "time outside of valid range",
          "strict_error": true
        }
      ]
    },
