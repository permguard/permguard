    "test-time-0970.yaml": {
      "sha256": "sha256:197599dd2f93fb6658475e68cdd1969dedc068542d2c6d363b8e7774d5abc7aa",
      "cases": [
        {
          "note": "time/diff",
          "query": "data.test.a = minute_second; data.test.b = different_tz; data.test.c = leap_year; data.test.d = not_leap_year; data.test.e = leap_year_one_day\n",
          "modules": [
            "package test\n\nlayout := \"2006-01-02\"\n\na := minute_second if {\n\tminute_second := time.diff(time.now_ns() + (((61 * 1000) * 1000) * 1000), time.now_ns())\n}\n\nb := different_tz if {\n\tdifferent_tz := time.diff([time.now_ns() + (((60 * 1000) * 1000) * 1000), \"UTC\"], [time.now_ns(), \"Asia/Shanghai\"])\n}\n\nc := leap_year if {\n\tleap_year := time.diff(time.parse_ns(layout, \"2020-02-02\"), time.parse_ns(layout, \"2020-03-01\"))\n}\n\nd := not_leap_year if {\n\tnot_leap_year := time.diff(time.parse_ns(layout, \"2021-02-02\"), time.parse_ns(layout, \"2021-03-01\"))\n}\n\ne := leap_year_one_day if {\n\tleap_year_one_day := time.diff(time.parse_ns(layout, \"2004-02-29\"), time.parse_ns(layout, \"2005-03-01\"))\n}\n"
          ],
          "want_result": [
            {
              "different_tz": [
                0,
                0,
                0,
                0,
                1,
                0
              ],
              "leap_year": [
                0,
                0,
                28,
                0,
                0,
                0
              ],
              "leap_year_one_day": [
                1,
                0,
                1,
                0,
                0,
                0
              ],
              "minute_second": [
                0,
                0,
                0,
                0,
                1,
                1
              ],
              "not_leap_year": [
                0,
                0,
                27,
                0,
                0,
                0
              ]
            }
          ]
        }
      ]
    },
