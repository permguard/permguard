    "test-array-0052.yaml": {
      "sha256": "sha256:826416bb81dc542ec796da74860a1f8a47ac15923f880c6335c90d355991fe12",
      "cases": [
        {
          "note": "array/reverse_123",
          "query": "data.test.p = x",
          "modules": [
            "package test\n\np := array.reverse(data.foo)\n"
          ],
          "data": {
            "foo": [
              1,
              2,
              3
            ]
          },
          "want_result": [
            {
              "x": [
                3,
                2,
                1
              ]
            }
          ]
        },
        {
          "note": "array/reverse_empty",
          "query": "data.test.p = x",
          "modules": [
            "package test\n\np := array.reverse(data.foo)\n"
          ],
          "data": {
            "foo": [

            ]
          },
          "want_result": [
            {
              "x": [

              ]
            }
          ]
        },
        {
          "note": "array/reverse_object_error",
          "query": "data.test.p = x",
          "modules": [
            "package test\n\np := array.reverse(data.foo)\n"
          ],
          "data": {
            "foo": {
              "bar": "baz",
              "baz": "bar"
            }
          },
          "want_error_code": "eval_type_error",
          "want_error": "array.reverse: operand 1 must be array but got object",
          "strict_error": true
        }
      ]
    }
