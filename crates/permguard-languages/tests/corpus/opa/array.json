{
  "folder": "array",
  "files": {
    "test-array-0041.yaml": {
      "sha256": "sha256:9e6eb6844c47a8d30ab52db1f0b4b82f633b743cb64dbab49198cbf022949b56",
      "cases": [
        {
          "note": "array/concat",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np := x if {\n\tarray.concat([1, 2], [3, 4], __local0__)\n\tx = __local0__\n}\n"
          ],
          "data": {
          },
          "want_result": [
            {
              "x": [
                1,
                2,
                3,
                4
              ]
            }
          ]
        }
      ]
    },
    "test-array-0042.yaml": {
      "sha256": "sha256:3928314d7d903b596122c1bfccd057367bd0390046ec2587526340613ff020f4",
      "cases": [
        {
          "note": "array/concat: err",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np := x if {\n\t__local1__ = data.b\n\tarray.concat(__local1__, [3, 4], __local0__)\n\tx = __local0__\n}\n"
          ],
          "data": {
            "b": {
              "v1": "hello",
              "v2": "goodbye"
            }
          },
          "want_error_code": "eval_type_error",
          "want_error": "array.concat: operand 1 must be array but got object",
          "strict_error": true
        }
      ]
    },
    "test-array-0043.yaml": {
