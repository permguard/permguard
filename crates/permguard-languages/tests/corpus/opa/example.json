                ]
              }
            ],
            "servers": [
              {
                "id": "s1",
                "name": "app",
                "ports": [
                  "p1",
                  "p2",
                  "p3"
                ],
                "protocols": [
                  "https",
                  "ssh"
                ]
              },
              {
                "id": "s2",
                "name": "db",
                "ports": [
                  "p3"
                ],
                "protocols": [
                  "mysql"
                ]
              },
              {
                "id": "s3",
                "name": "cache",
                "ports": [
                  "p3"
                ],
                "protocols": [
                  "memcache",
                  "http"
                ]
              },
              {
                "id": "s4",
                "name": "dev",
                "ports": [
                  "p1",
                  "p2"
                ],
                "protocols": [
                  "http"
                ]
              }
            ]
          },
          "input_term": "{}",
          "want_result": [
            {
              "x": [
                {
