    "test-comparisonexpr-0608.yaml": {
      "sha256": "sha256:1ca04ee157ae24e460276d3f5503939216cca51134457bbeaf52728944c79d87",
      "cases": [
        {
          "note": "comparisonexpr/equals",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np if {\n\t1 = 1\n\tdata.a[i] = x\n\tx = 2\n}\n"
          ],
          "data": {
            "a": [
              1,
              2,
              3,
              4
            ]
          },
          "want_result": [
            {
              "x": true
            }
          ]
        }
      ]
    },
