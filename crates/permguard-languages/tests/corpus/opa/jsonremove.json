          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np := __local0__ if {\n\t__local2__ = input.x\n\tjson.remove(__local2__, {\"a/b/c\"}, __local1__)\n\t__local0__ = __local1__\n}\n"
          ],
