    "test-partialsetdoc-0515.yaml": {
      "sha256": "sha256:573410eabe6e8680a7d4348abc6b2ba1974d8a58321103a0c384a42614374579",
      "cases": [
        {
          "note": "partialsetdoc/nested composites",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np contains x if {\n\tdata.f[i] = x\n}\n"
          ],
          "data": {
            "f": [
              {
                "xs": [
                  "1"
                ],
                "ys": [
                  "2"
                ]
              },
              {
                "xs": [
                  "2"
                ],
                "ys": [
                  "3"
                ]
              }
            ]
          },
          "want_result": [
            {
              "x": [
                {
                  "xs": [
                    "1"
                  ],
                  "ys": [
                    "2"
                  ]
                },
                {
                  "xs": [
                    "2"
                  ],
                  "ys": [
                    "3"
                  ]
                }
              ]
            }
          ],
          "sort_bindings": true
