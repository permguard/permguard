    "test-issue-3369.yaml": {
      "sha256": "sha256:2478160fad92733e3699fb5e746e1b323625fddf869e3aa717530e6e99168a2e",
      "cases": [
        {
          "note": "partialsetdoc/unexpected 'var requires evaluation'",
          "query": "data.x.p[x] = z",
          "modules": [
            "package x\n\np contains a if {\n\ta := q\n}\n\nq contains b if {\n\tb := 1\n}\n"
          ],
          "want_result": [
            {
              "x": [
                1
              ],
              "z": [
                1
              ]
            }
          ]
        }
      ]
    },
    "test-issue-3376.yaml": {
      "sha256": "sha256:991aabad48045298cbc6102c537dacb4b4edcdd60ef5df0ace4feaf8bf113c8d",
      "cases": [
        {
          "note": "partialsetdoc/iteration",
          "query": "data.foo.p = x",
          "modules": [
            "package foo\n\np if {\n\tq[i][j] = v # this fails!\n}\n\nq contains x if {\n\tx = r\n}\n\nr contains x if {\n\tx = [1]\n}\n"
          ],
          "want_result": [
            {
              "x": true
            }
          ]
        }
      ]
    },
    "test-issue-3819.yaml": {
      "sha256": "sha256:94e06b60cf8c48d8c5946bac897ff497e52fc6f7bccaac51f3ab35267a4bcec7",
      "cases": [
        {
          "note": "partialsetdoc: object sort while iter",
          "query": "data.foo.p = x",
          "modules": [
            "package foo\n\np contains x if {\n\tdata.a[x] # iterates data.a\n\tq[_]\n}\n\nq contains x if {\n\tx = data.a # inserts data.a into a set, sorts the object keys\n}\n"
          ],
          "data": {
            "a": {
              "apples": "2",
              "bananas": "1",
              "clementines": "3"
            }
          },
          "want_result": [
            {
              "x": [
                "apples",
                "bananas",
                "clementines"
              ]
            }
          ],
          "sort_bindings": true
        }
      ]
    },
