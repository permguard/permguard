    "test-partialsetdoc-0516.yaml": {
      "sha256": "sha256:d969a19f0e717cc072da984ad38b31bfeeaedd713c3cb4be4067b5cfe61c6501",
      "cases": [
        {
          "note": "partialsetdoc/deep ref/heterogeneous",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np contains x if {\n\tdata.c[i][j][k] = x\n}\n"
          ],
          "data": {
            "c": [
              {
                "true": [
                  null,
                  3.14159
                ],
                "x": [
                  true,
                  false,
                  "foo"
                ],
                "z": {
                  "p": true,
                  "q": false
                }
              }
            ]
          },
          "want_result": [
            {
              "x": [
                null,
                false,
                true,
                3.14159,
                "foo"
              ]
            }
          ],
          "sort_bindings": true
        }
      ]
    },
    "test-partialsetdoc-0517.yaml": {
