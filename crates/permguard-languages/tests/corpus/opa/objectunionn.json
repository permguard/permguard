{
  "folder": "objectunionn",
  "files": {
    "test-objectunionn-0001.yaml": {
      "sha256": "sha256:6c27ce1e4cb73b31e604c1d858dd4967f46cddee8338889a51482f81444f02b6",
      "cases": [
        {
          "note": "objectunionn/empty array",
          "query": "data.test.p = x",
          "modules": [
            "package test\n\np := object.union_n([{}])\n"
          ],
          "want_result": [
            {
              "x": {
              }
            }
          ]
        },
        {
          "note": "objectunionn/single item array",
          "query": "data.test.p = x",
          "modules": [
            "package test\n\np := object.union_n([{\"foo\": \"bar\"}])\n"
          ],
          "want_result": [
            {
              "x": {
                "foo": "bar"
              }
            }
          ]
        },
        {
          "note": "objectunionn/merge objects",
          "query": "data.test.x = x",
          "modules": [
            "package test\n\nx := object.union_n([{\"foo\": \"bar\"}, {\"x\": \"y\"}])\n"
          ],
          "want_result": [
            {
              "x": {
                "foo": "bar",
                "x": "y"
              }
            }
          ]
        },
        {
          "note": "objectunionn/merge objects conflict",
          "query": "data.test.x = x",
          "modules": [
            "package test\n\nx := object.union_n([{\"foo\": \"bar\"}, {\"foo\": \"baz\"}])\n"
          ],
          "want_result": [
            {
              "x": {
                "foo": "baz"
              }
            }
          ]
        },
        {
          "note": "objectunionn/merge objects extended",
          "query": "data.test.x = x",
          "modules": [
            "package test\n\nx := object.union_n([\n\t{\n\t\t\"a\": 1,\n\t\t\"b\": 2,\n\t\t\"c\": 3,\n\t},\n\t{\n\t\t\"foo\": \"baz\",\n\t\t\"a\": \"a\",\n\t\t\"b\": 2,\n\t\t\"d\": 4,\n\t},\n\t{\n\t\t\"a\": \"final A!\",\n\t\t\"e\": 5.0,\n\t},\n])\n"
          ],
          "want_result": [
            {
              "x": {
                "a": "final A!",
                "b": 2,
                "c": 3,
                "d": 4,
                "e": 5,
                "foo": "baz"
              }
            }
          ]
        },
        {
          "note": "# 5073 regression test",
          "query": "data.test.x = x",
          "modules": [
            "package test\n\nx := object.union_n(input)\n"
          ],
          "input_term": "[{\"foo\": 1}, {\"bar\": 2}, \"baz\"]",
          "want_error_code": "eval_type_error",
          "strict_error": true
        }
      ]
    }
  }
}
