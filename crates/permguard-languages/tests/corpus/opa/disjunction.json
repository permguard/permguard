    "test-disjunction-0772.yaml": {
      "sha256": "sha256:e2d5753eb241dedf009342108124eb23a1f0622bb7222a0ad7d68f87edc30c89",
      "cases": [
        {
          "note": "disjunction/complete: error",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np := true\n\np := false if {\n\tfalse\n}\n\np := false\n"
          ],
          "data": {
          },
          "want_error_code": "eval_conflict_error",
          "want_error": "complete rules must not produce multiple outputs"
