              "v1": "hello",
              "v2": "goodbye"
            }
          },
          "want_result": [
            {
              "x": [
                "1",
                "2",
                "3",
                "4",
                "goodbye",
                "hello"
              ]
            }
          ],
          "sort_bindings": true
        }
      ]
    },
