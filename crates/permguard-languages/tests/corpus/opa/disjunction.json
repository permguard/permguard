{
  "folder": "disjunction",
  "files": {
    "test-disjunction-0763.yaml": {
      "sha256": "sha256:564ece3fc023a28deeae00155ddbb99ab2d740316ffe82525e99db1efdc9a187",
      "cases": [
        {
          "note": "disjunction/incr: query set",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np contains x if {\n\tdata.a[i] = x\n}\n\np contains y if {\n\tdata.b[j] = y\n}\n"
          ],
          "data": {
            "a": [
              "1",
              "2",
              "3",
              "4"
            ],
            "b": {
              "v1": "hello",
              "v2": "goodbye"
            }
          },
          "want_result": [
            {
              "x": [
                "1",
                "2",
                "3",
                "4",
                "goodbye",
                "hello"
              ]
            }
          ],
          "sort_bindings": true
        }
      ]
    },
    "test-disjunction-0764.yaml": {
      "sha256": "sha256:fa676f2f89575eb2155a152641045827813100ac60a6d6b740003df8f3940b04",
      "cases": [
        {
          "note": "disjunction/incr: query set constants",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np contains 100\n\np contains x if {\n\tdata.a[x]\n}\n"
          ],
          "data": {
            "a": [
              "1",
              "2",
              "3",
              "4"
            ]
          },
          "want_result": [
            {
              "x": [
                0,
                1,
                2,
                3,
                100
              ]
            }
          ],
          "sort_bindings": true
        }
      ]
    },
    "test-disjunction-0765.yaml": {
      "sha256": "sha256:0b18f84a68d53d8d2b4639875e0eb456c211fe8084d9daea4c39d08355722aa8",
      "cases": [
        {
          "note": "disjunction/incr: query object",
          "query": "data.generated.p = x",
          "modules": [
            "package generated\n\np[k] := v if {\n\tdata.b[v] = k\n}\n\np[k] := v if {\n\tdata.a[i] = v\n\tdata.g[k][j] = v\n}\n"
          ],
          "data": {
            "a": [
              "1",
              "2",
              "3",
              "4"
            ],
            "b": {
              "v1": "hello",
              "v2": "goodbye"
            },
            "g": {
              "a": [
                "1",
                "0",
                "0",
                "0"
              ],
              "b": [
                "0",
                "2",
                "0",
                "0"
              ],
              "c": [
                "0",
                "0",
                "0",
                "4"
              ]
            }
          },
          "want_result": [
            {
              "x": {
                "a": "1",
                "b": "2",
                "c": "4",
                "goodbye": "v2",
                "hello": "v1"
              }
            }
          ]
        }
      ]
    },
    "test-disjunction-0766.yaml": {
      "sha256": "sha256:d7be2cad300376b0fa35b32db3edee81cdf180dec3568d718814e81ca09ab39b",
