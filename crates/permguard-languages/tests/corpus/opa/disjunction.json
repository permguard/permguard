          "modules": [
            "package generated\n\np contains x if {\n\tdata.generated.q = s\n\ts[x]\n}\n\nq contains x if {\n\tdata.a[_0] = x\n}\n\nq contains y if {\n\tdata.b[_0] = y\n}\n"
